# CodeMind AI - Backend Configuration

# Server
CODEMIND_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database & Vector Store
SQLITE_DB_URL=sqlite+aiosqlite:///./data/codemind.db
CHROMA_PERSIST_DIR=./data/chroma_db

# LLM Provider Configuration
# Supported providers: 'local' (offline deterministic AST/keyword grounding), 'gemini', 'openai', 'groq', 'ollama'
LLM_PROVIDER=local
LLM_MODEL=default

# Provider API Keys (leave empty when using local mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Configuration
# Supported: 'local' (Chroma all-MiniLM-L6-v2 ONNX), 'gemini', 'openai'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ingestion & Chunking Limits
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
MAX_FILE_SIZE_KB=500
MAX_REPO_FILES=500

# GitHub Integration
# Optional personal access token for higher rate limits (60/hr -> 5000/hr)
GITHUB_TOKEN=
